{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/cli.ts",
    "src/plugin-api.ts",
    "src/plugin-api/unstable.ts",
    "extensions/pi-web.ts",
    "extensions/research-library.ts",
    "pi-web-plugins/**/pi-web-plugin.ts",
    "scripts/*.mjs"
  ],
  "project": [
    "src/**/*.ts",
    "extensions/**/*.ts",
    "pi-web-plugins/**/*.ts"
  ],
  "ignoreBinaries": ["taskkill"],
  "ignoreExportsUsedInFile": true
}
