{
  "name": "pi-web-code-review",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace file and Git review comments for PI WEB, without host modifications.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:artifacts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jmfederico/pi-web": "1.202610.1",
    "@noble/hashes": "^2.4.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.6.0",
    "fake-indexeddb": "^6.2.4",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.1",
    "lit": "^3.3.3",
    "marked": "^18.0.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "piWeb": {
    "plugins": [
      {
        "id": "code-review",
        "browserRoot": "dist/browser",
        "module": "dist/browser/index.js",
        "serverModule": "dist/server.js",
        "machineSpecific": true
      }
    ]
  }
}
